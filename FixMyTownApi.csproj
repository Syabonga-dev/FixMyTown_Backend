<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Talks to SQL Server -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.8" />

    <!-- JWT login tokens, same idea as the Node version's jsonwebtoken package -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />

    <!-- Password hashing, same idea as the Node version's bcryptjs package -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />

    <!-- Swagger - lets you test every endpoint from a browser page, handy while building -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />

    <!-- Generates real .xlsx files for the dynamic report's Export Excel button -
         writes actual cells, not comma-separated text, so it always opens
         correctly regardless of the user's regional Excel settings -->
    <PackageReference Include="ClosedXML" Version="0.104.1" />
  </ItemGroup>

</Project>
